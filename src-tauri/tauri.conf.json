{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prabhupada Connect",
  "version": "0.2.0",
  "identifier": "com.prabhupada.connect.v3",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Prabhupāda Connect",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../database/prabhupada_corpus.db": "database/prabhupada_corpus.db"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
